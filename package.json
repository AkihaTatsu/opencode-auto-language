{
  "name": "opencode-auto-language",
  "version": "0.1.0",
  "private": true,
  "description": "Follow the user's language in OpenCode reasoning, replies and native session workflows using offline language detection.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
